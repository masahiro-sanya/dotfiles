#!/bin/bash
# dotfiles pre-commit: staged ファイルのみを対象にした軽量チェック
# - claude/settings.json: JSON 妥当性 + ランタイムフィールド（コミット禁止）の検出
# - codex/hooks.json / claude/keybindings.json: JSON 妥当性
# - launchd/*.plist.template: plist として読めるか
# - 全 staged ファイル: 高確度の秘密パターン検知（AWSキー・GitHub PAT・秘密鍵 等）
# - ~/.claude/private/denylist.txt（git 管理外・あれば）に一致する語が追加行に入っていないか
# - *.sh: bash -n（staged 内容で検証）
# - claude/hooks/*.sh が staged のときだけ hooks 回帰テストを実行
# 配線: setup.sh が `git config core.hooksPath .githooks` を設定する
# macOS 標準 bash 3.2 互換で書く

set -u

fail=0

err() {
    printf 'pre-commit: %s\n' "$1" >&2
    fail=1
}

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "${staged}" ]; then
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "${PWD}")"
runtime_filter="${repo_root}/git/strip-claude-runtime.sh"

run_hook_tests=0

# 再混入チェック: 公開リポに載せたくない語のパターン（rg の正規表現・1 行 1 つ・'#' 始まりと空行は無視）を
# git 管理外の denylist から読む。無い／rg が無いときは何もしない。
# 一致した語そのものは出さない（ログや画面に残さないため）。テスト用に PRECOMMIT_DENYLIST で差し替え可
denylist_file="${PRECOMMIT_DENYLIST:-${HOME}/.claude/private/denylist.txt}"
denylist_pats=""
if [ -f "${denylist_file}" ] && command -v rg >/dev/null 2>&1; then
    denylist_pats="$(mktemp)"
    trap 'command rm -f "${denylist_pats}"' EXIT
    /usr/bin/grep -vE '^[[:space:]]*(#|$)' "${denylist_file}" > "${denylist_pats}" 2>/dev/null || true
    [ -s "${denylist_pats}" ] || { command rm -f "${denylist_pats}"; denylist_pats=""; }
fi

# 高確度の秘密パターン（形式が確定的なもののみ。誤検知を抑えるため緩いパターンは入れない）
# AWS アクセスキー / GitHub PAT（新旧）/ Slack token / Anthropic API key / Google API key / PEM 秘密鍵
secret_pat='AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|xox[baprs]-[0-9A-Za-z-]{10,}|sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|-----BEGIN( [A-Z]+)? PRIVATE KEY-----'

while IFS= read -r f; do
    case "${f}" in
        claude/settings.json)
            content="$(git show :claude/settings.json)"
            if ! printf '%s\n' "${content}" | jq . >/dev/null 2>&1; then
                err "claude/settings.json が JSON としてパースできません"
            else
                # キー一覧は git/strip-claude-runtime.sh が唯一の定義元（--check に委ねる）
                if [ ! -f "${runtime_filter}" ]; then
                    printf 'pre-commit: %s が無いためランタイムフィールド検査を省略しました\n' "${runtime_filter}" >&2
                    bad=""
                else
                    bad="$(printf '%s\n' "${content}" | bash "${runtime_filter}" --check)"
                fi
                if [ -n "${bad}" ]; then
                    err "claude/settings.json にランタイムフィールドが含まれています（コミット禁止）: $(printf '%s' "${bad}" | tr '\n' ' ')"
                    err "  clean filter が未登録の可能性があります。setup.sh を実行するか、次を1回実行してください:"
                    err "    git config filter.strip-claude-runtime.clean \"bash \$PWD/git/strip-claude-runtime.sh\""
                    err "    git config filter.strip-claude-runtime.smudge cat"
                    err "  登録後に git add し直すと、実ファイルは無傷のまま index からだけ除去されます"
                fi
            fi
            ;;
        codex/hooks.json|claude/keybindings.json)
            if ! git show ":${f}" | jq . >/dev/null 2>&1; then
                err "${f} が JSON としてパースできません"
            fi
            ;;
        launchd/*.plist.template)
            if ! git show ":${f}" | python3 -c 'import plistlib,sys; plistlib.load(sys.stdin.buffer)' >/dev/null 2>&1; then
                err "${f} が plist として読めません"
            fi
            ;;
    esac

    # denylist 検知（追加行だけを見る）
    # パス自体が一致したときはパスも出さない（語がそのまま画面に残るため）。
    # rg の終了コード 2（パターン不正等）は「一致なし」と区別して知らせる
    if [ -n "${denylist_pats}" ]; then
        printf '%s\n' "${f}" | rg -q -f "${denylist_pats}" 2>/dev/null
        path_rc=$?
        if [ "${path_rc}" -eq 0 ]; then
            err "denylist に一致するファイルパスが staged されています（パスは表示しません）"
        fi
        git diff --cached -U0 -- "${f}" 2>/dev/null | /usr/bin/grep -E '^\+' | /usr/bin/grep -vE '^\+\+\+ ' | rg -q -f "${denylist_pats}" 2>/dev/null
        line_rc=$?
        if [ "${line_rc}" -eq 0 ]; then
            if [ "${path_rc}" -eq 0 ]; then
                err "denylist に一致する追加行があります（パスは表示しません）"
            else
                err "denylist に一致する追加行があります: ${f}"
            fi
        elif [ "${line_rc}" -ge 2 ] || [ "${path_rc}" -ge 2 ]; then
            printf 'pre-commit: denylist のパターンを rg が読めず、検査できませんでした\n' >&2
        fi
    fi

    # 秘密パターン検知（staged 内容全体を対象。このリポに秘密が存在してよい場所はない）
    if git show ":${f}" 2>/dev/null | /usr/bin/grep -qE "${secret_pat}"; then
        err "秘密情報らしき文字列を検知: ${f}（AWSキー/GitHub PAT/Slack token/APIキー/秘密鍵の形式）"
        err "  実物なら即座に取り消し・ローテーションし、キーチェーン等へ移す。誤検知ならユーザー確認の上で対応を決める"
    fi

    case "${f}" in
        *.sh)
            if ! out="$(git show ":${f}" | bash -n 2>&1)"; then
                err "bash -n 失敗: ${f}"
                printf '%s\n' "${out}" >&2
            fi
            ;;
    esac

    case "${f}" in
        claude/hooks/*.sh)
            run_hook_tests=1
            ;;
    esac
done <<EOF
${staged}
EOF

if [ "${run_hook_tests}" -eq 1 ]; then
    if ! out="$(bash claude/hooks/tests/run-tests.sh 2>&1)"; then
        err "claude/hooks の回帰テストが失敗しました"
        printf '%s\n' "${out}" >&2
    fi
fi

exit "${fail}"
