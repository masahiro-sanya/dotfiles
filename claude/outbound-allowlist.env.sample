# 対人送信ガード（claude/hooks/guard-outbound-comms.sh）の許可リスト。
#
# ~/.claude/outbound-allowlist.env に置く。このリポは公開なので、実値（社内の
# チャンネル ID・ユーザーグループ ID）はコミットせず、各マシンで手で書く。
# ファイルが無ければ両方とも空＝メンションは全部ブロックで、安全側に倒れる。
#
#   cp claude/outbound-allowlist.env.sample ~/.claude/outbound-allowlist.env
#
# 書式は KEY=値 の 1 行だけ。ガードは source せず sed で読むので、
# シェルの展開（$VAR やコマンド置換）は使えない。
#
# CHANNELS: 承認なしで一斉呼び出しを許すチャンネル ID を空白区切り。
#           C で始まる ID だけが有効（DM チャンネル D… やユーザー ID U… は載せられない）。
# MENTIONS: 許可する呼びかけ先を空白区切り。here / channel / everyone /
#           subteam^S0123ABCD のいずれかだけが有効。
#           個人宛（<@U…>）と素の @名前 はここに書いても無視され、必ずブロックされる。
#           許可した呼びかけ先に個人宛が 1 つでも混ざれば、その送信は全体がブロックされる。
#
# 障害通知チャンネルで当番グループを叩く、という用途を想定した例:
OUTBOUND_SLACK_MENTION_ALLOW_CHANNELS="C0123ABCD C0456EFGH"
OUTBOUND_SLACK_MENTION_ALLOW_MENTIONS="subteam^S0123ABCD"
