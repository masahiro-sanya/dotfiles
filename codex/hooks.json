{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "WEZTERM_STATUS_AGENT=codex bash ~/.claude/hooks/wezterm-status.sh SessionStart", "timeout": 5 }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "if [ -x ~/.codex/herdr-agent-state.sh ]; then bash ~/.codex/herdr-agent-state.sh session; fi", "timeout": 10 }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/codex-pane-title.sh SessionStart", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "WEZTERM_STATUS_AGENT=codex bash ~/.claude/hooks/wezterm-status.sh UserPromptSubmit", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/codex-pane-title.sh UserPromptSubmit", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "WEZTERM_STATUS_AGENT=codex bash ~/.claude/hooks/wezterm-status.sh PreToolUse", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/guard-bash-command.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/guard-review-push.sh", "timeout": 5 },
          { "type": "command", "command": "bash ~/.claude/hooks/guard-outbound-comms.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "mcp__.*(slack|notion).*",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/guard-outbound-comms.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "WEZTERM_STATUS_AGENT=codex bash ~/.claude/hooks/wezterm-status.sh PostToolUse", "timeout": 5 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "WEZTERM_STATUS_AGENT=codex bash ~/.claude/hooks/wezterm-status.sh PermissionRequest", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "WEZTERM_STATUS_AGENT=codex bash ~/.claude/hooks/wezterm-status.sh Stop", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/codex-pane-title.sh SessionEnd", "timeout": 5 }
        ]
      }
    ]
  }
}
